{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/sync-write.json",
  "title": "A sync write",
  "description": "PATCH <base>/v1/sync/{collection} (SPEC.md § 20.4): items sent, merged by the rule of § 20.4. A wish's key is <platform>/<title_id>; installed's, the device's own id.",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "common.json#/$defs/schema1"
    },
    "generation": {
      "$ref": "common.json#/$defs/generation"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "allOf": [
          {
            "$ref": "common.json#/$defs/sync_item"
          },
          {
            "not": {
              "required": [
                "rev"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "generation",
    "items"
  ]
}
