{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/homebrew-page.json",
  "title": "Homebrew page",
  "description": "GET <base>/v1/homebrew and POST <base>/v1/homebrew/updates (SPEC.md § 8.5).",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "common.json#/$defs/schema1"
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "common.json#/$defs/homebrew"
      }
    },
    "total": {
      "$ref": "common.json#/$defs/uint53"
    },
    "next": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/opaque"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "items",
    "next"
  ]
}
