{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/handshake.json",
  "title": "Handshake",
  "description": "GET /.well-known/lantern and GET <base>/v1/ (SPEC.md § 4.2).",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "common.json#/$defs/schema1"
    },
    "uid": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "$ref": "common.json#/$defs/name"
    },
    "software": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "common.json#/$defs/name"
        },
        "version": {
          "$ref": "common.json#/$defs/name"
        }
      }
    },
    "base": {
      "$ref": "common.json#/$defs/url"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "platforms": {
      "description": "The platforms the server has something for (SPEC.md § 4.3).",
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/platform"
      },
      "uniqueItems": true
    },
    "motd": {
      "$ref": "common.json#/$defs/text"
    },
    "account": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "common.json#/$defs/name"
        },
        "state": {
          "enum": [
            "anonymous",
            "active",
            "frozen"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/scope"
          },
          "uniqueItems": true
        },
        "bound": {
          "type": "boolean",
          "description": "Whether the caller's token is bound to a device key (SPEC.md § 5.4)."
        },
        "rating_cap": {
          "$ref": "common.json#/$defs/rating_cap"
        }
      },
      "required": [
        "state",
        "scopes"
      ]
    },
    "features": {
      "type": "object",
      "description": "Per family, the schema the server writes for it, or 0 when not offered to this caller.",
      "properties": {
        "library": {
          "type": "integer",
          "minimum": 0
        },
        "titles": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "integer",
          "minimum": 0
        },
        "sections": {
          "type": "integer",
          "minimum": 0
        },
        "homebrew": {
          "type": "integer",
          "minimum": 0
        },
        "saves": {
          "type": "integer",
          "minimum": 0
        },
        "cheats": {
          "type": "integer",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "pairing": {
          "type": "integer",
          "minimum": 0
        },
        "signatures": {
          "type": "integer",
          "minimum": 0
        },
        "admin": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "peers": {
          "type": "integer",
          "minimum": 0
        },
        "sync": {
          "type": "integer",
          "minimum": 0
        },
        "encrypted_saves": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "save_body": {
          "$ref": "common.json#/$defs/uint64",
          "description": "The largest save a single request takes (SPEC.md § 9.2)."
        },
        "save_size": {
          "$ref": "common.json#/$defs/uint64",
          "description": "The largest save at all (SPEC.md § 9.3)."
        },
        "saves_kept_per_title": {
          "type": "integer",
          "minimum": 1,
          "description": "Backups kept per title, platform and account (SPEC.md § 9.1)."
        },
        "heartbeat": {
          "type": "integer",
          "minimum": 5,
          "maximum": 60,
          "description": "Seconds between two heartbeats of an event stream at most (SPEC.md § 18.4)."
        },
        "event_streams": {
          "type": "integer",
          "minimum": 1,
          "description": "Event streams a token holds at once (SPEC.md § 18.4)."
        },
        "wait": {
          "type": "integer",
          "minimum": 30,
          "maximum": 300,
          "description": "The longest wait of a long poll, in seconds (SPEC.md § 18.3)."
        },
        "sync_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "Items a sync collection holds at most (SPEC.md § 20.5)."
        }
      }
    },
    "language": {
      "$ref": "common.json#/$defs/language",
      "description": "The language of motd (SPEC.md § 2.2)."
    },
    "auth": {
      "type": "object",
      "description": "Signed requests (SPEC.md § 5.4).",
      "properties": {
        "bearer_only": {
          "type": "boolean",
          "description": "Whether the server still issues and takes tokens no key binds."
        },
        "skew": {
          "type": "integer",
          "minimum": 60,
          "maximum": 900,
          "description": "Seconds a signature's created may differ from the server's clock."
        }
      },
      "required": [
        "bearer_only",
        "skew"
      ]
    },
    "peers": {
      "type": "object",
      "description": "The server's grants (SPEC.md § 19.3): its grant key's public key, the same for every caller, and a grant's lifetime.",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "grant_lifetime": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      },
      "required": [
        "key",
        "grant_lifetime"
      ]
    },
    "static": {
      "type": "object",
      "description": "A static library's (SPEC.md § 21.2): when its files were written, and the size of its pages.",
      "properties": {
        "generated": {
          "$ref": "common.json#/$defs/time"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "generated",
        "page_size"
      ]
    }
  },
  "required": [
    "schema",
    "uid",
    "name",
    "base",
    "versions",
    "platforms",
    "account",
    "features"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "events": {
                "minimum": 1
              }
            },
            "required": [
              "events"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "properties": {
          "limits": {
            "required": [
              "heartbeat",
              "event_streams",
              "wait"
            ]
          }
        },
        "required": [
          "limits"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "peers": {
                "minimum": 1
              }
            },
            "required": [
              "peers"
            ]
          }
        },
        "required": [
          "features"
        ]
      },
      "then": {
        "required": [
          "peers"
        ]
      }
    },
    {
      "if": {
        "required": [
          "static"
        ]
      },
      "then": {
        "properties": {
          "account": {
            "properties": {
              "state": {
                "const": "anonymous"
              }
            }
          },
          "features": {
            "properties": {
              "changes": {
                "const": 0
              },
              "sections": {
                "const": 0
              },
              "saves": {
                "const": 0
              },
              "encrypted_saves": {
                "const": 0
              },
              "requests": {
                "const": 0
              },
              "pairing": {
                "const": 0
              },
              "signatures": {
                "const": 0
              },
              "admin": {
                "const": 0
              },
              "events": {
                "const": 0
              },
              "peers": {
                "const": 0
              },
              "sync": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
