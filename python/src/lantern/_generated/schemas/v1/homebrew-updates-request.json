{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/homebrew-updates-request.json",
  "title": "Installed homebrew",
  "description": "POST <base>/v1/homebrew/updates, with a platform (SPEC.md § 8.5).",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "common.json#/$defs/schema1"
    },
    "installed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/homebrew_id"
          },
          "build": {
            "$ref": "common.json#/$defs/uint64"
          }
        },
        "required": [
          "id",
          "build"
        ]
      }
    }
  },
  "required": [
    "schema",
    "installed"
  ]
}
