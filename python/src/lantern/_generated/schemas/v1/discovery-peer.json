{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/discovery-peer.json",
  "title": "LAN discovery reply of a peer",
  "description": "A peer's answer, unicast, to a discovery request that asks for peers (SPEC.md § 19.5). A hint only: what a peer serves is checked by its SHA-256.",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "common.json#/$defs/schema1"
    },
    "lantern": {
      "const": "peer"
    },
    "uid": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "$ref": "common.json#/$defs/name"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "base": {
      "$ref": "common.json#/$defs/url"
    },
    "tls": {
      "type": "boolean"
    },
    "slots": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "required": [
    "schema",
    "lantern",
    "uid",
    "name",
    "port",
    "base",
    "tls",
    "slots",
    "servers"
  ]
}
