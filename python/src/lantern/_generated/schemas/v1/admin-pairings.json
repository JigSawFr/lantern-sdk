{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/admin-pairings.json",
  "title": "Pairings waiting",
  "description": "GET <base>/v1/admin/pairings (SPEC.md § 5.7).",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "common.json#/$defs/admin_pairing"
          }
        },
        "total": {
          "$ref": "common.json#/$defs/uint53"
        },
        "next": {
          "oneOf": [
            {
              "$ref": "common.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "common.json#/$defs/schema1"
        }
      },
      "required": [
        "schema"
      ]
    }
  ]
}
