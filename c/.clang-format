---
# clang-format 18 (the CI pins 18.1.8 from PyPI): cpp/.clang-format's style,
# Aurore's, for the C API's C and C++ alike; but the bodies of extern "C"
# blocks are not indented, and their brace stays on the line.
BasedOnStyle: WebKit
Standard: c++20
ColumnLimit: 110
AccessModifierOffset: -2
AlignConsecutiveAssignments: true
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: false
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
IndentExternBlock: NoIndent
IndentCaseLabels: true
PointerAlignment: Left
FixNamespaceComments: true
NamespaceIndentation: None
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: All
InsertBraces: false
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^<lantern/'
    Priority: 3
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<'
    Priority: 2
  - Regex: '.*'
    Priority: 4
...
