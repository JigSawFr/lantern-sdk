{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/admin-requests.json",
  "title": "Every account's requests",
  "description": "GET <base>/v1/admin/requests (SPEC.md § 11, § 5.7): newest first, each with its user.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "allOf": [
              {
                "$ref": "common.json#/$defs/request"
              },
              {
                "required": [
                  "user"
                ]
              }
            ]
          }
        },
        "total": {
          "$ref": "common.json#/$defs/uint53"
        },
        "next": {
          "oneOf": [
            {
              "$ref": "common.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next"
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "common.json#/$defs/schema1"
        }
      },
      "required": [
        "schema"
      ]
    }
  ]
}
