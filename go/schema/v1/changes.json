{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/changes.json",
  "title": "Changes",
  "description": "GET <base>/v1/changes (SPEC.md § 6.4); with wait, a long poll, and its events (§ 18.3).",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "common.json#/$defs/schema1"
    },
    "added": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/app"
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/opaque"
      }
    },
    "since": {
      "$ref": "common.json#/$defs/opaque"
    },
    "events": {
      "type": "array",
      "description": "With wait: the events after since, in order (SPEC.md § 18.3).",
      "items": {
        "$ref": "common.json#/$defs/event"
      }
    }
  },
  "required": [
    "schema",
    "added",
    "removed",
    "since"
  ]
}
